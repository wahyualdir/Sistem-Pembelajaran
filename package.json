{
  "name": "siakad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prebuild.js && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:rls": "tsx scripts/check-rls.ts",
    "snapshot": "node scripts/generate-schema-snapshot.mjs",
