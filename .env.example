# Konfigurasi Database Supabase (Prisma)
# Gunakan connection string dengan pgbouncer/pooling untuk DATABASE_URL
DATABASE_URL=""
# Gunakan direct connection string untuk migrasi Prisma
DIRECT_URL=""

# Konfigurasi Supabase Client & Auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Kunci Rahasia Aplikasi untuk Penandatanganan Token Impersonasi HMAC-SHA256
APP_SECRET=""

# Aturan Domain Mahasiswa Google OAuth (pencocokan persis di server, pisahkan koma jika jamak)
ALLOWED_EMAIL_DOMAINS="student.uir.ac.id"
ALLOWED_EMAIL_DOMAIN="student.uir.ac.id"

# Base URL Aplikasi untuk Redirect & Callback
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Login Flag (hanya aktif di development jika bernilai "true")
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
# Kata sandi akun demo untuk pengembangan/pengujian lokal (jangan tulis kata sandi di kode sumber)
DEMO_PASSWORD=""

# Kunci Rahasia Autentikasi Endpoint Cron Terjadwal (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=""

# Feature Flags Persistensi Database (Fase 3A - 3F)
FF_PERSISTENCE_ACADEMIC="true"
FF_PERSISTENCE_GRADES="true"
FF_PERSISTENCE_ATTENDANCE="true"
FF_PERSISTENCE_QUIZ="true"
FF_PERSISTENCE_DISPUTES="true"
FF_PERSISTENCE_CONTENT="true"

# Integrasi AI Academic Assistant & Evaluasi Esai Otomatis (Google Gemini API)
GEMINI_API_KEY=""

# Integrasi Sandbox Eksekusi Live Coding Terisolasi (Piston API - Wajib menggunakan instance server mandiri / self-hosted demi keamanan dan kuota, jangan gunakan publik)
PISTON_API_URL=""

# Distributed Rate Limiting Multi-Instance (Upstash Redis REST API - Opsional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Auto-Grader Koding & Online Judge (Lampiran D)
JUDGE_API_URL=""
JUDGE_API_KEY=""
JUDGE_WEBHOOK_SECRET=""

# Model AI SIAJAR (Lampiran D)
AI_MODEL=""

